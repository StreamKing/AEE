---
import Termin_card from "../components/Termin_card.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const termine = await getCollection("termine");

const parseDate = (str: string): number => {
  const [day, month, year] = str.split(".");
  return Date.parse(`${year}-${month}-${day}`);
};

const now = Date.now();

termine.sort(
  (a, b) => parseDate(a.data.date ?? "") - parseDate(b.data.date ?? ""),
);

const upcoming = termine.filter((t) => parseDate(t.data.date ?? "") >= now);
const past = termine.filter((t) => parseDate(t.data.date ?? "") < now).reverse();
const spotlight = upcoming.shift();
---

<Layout>
  <h1>Termine und Veranstaltungen</h1>

  <ul class="blog-post-card-container">
    {spotlight && (
      <li class="blog-post spotlight">
        <Termin_card termin={spotlight} spotlight={true} />
      </li>
    )}
    {upcoming.map((termin) => (
      <li class="blog-post">
        <Termin_card termin={termin} />
      </li>
    ))}
  </ul>

  {past.length > 0 && (
    <h2 class="section-heading">Vergangene Termine</h2>
    <ul class="blog-post-card-container past">
      {past.map((termin) => (
        <li class="blog-post">
          <Termin_card termin={termin} />
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  h1 {
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .section-heading {
    text-align: center;
    margin-top: 2.5rem;
    margin-bottom: 1.2rem;
  }

  .blog-post-card-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 980px);
    margin-inline: auto;
    padding: 0;
    margin-top: 0;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }

    row-gap: 1.1rem;
    column-gap: 1.1rem;

    .blog-post {
      list-style: none;

      &.spotlight {
        grid-column: 1 / -1;
      }
    }
  }
</style>
