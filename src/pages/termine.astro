---
import BlogCard from "../components/Termin_card.astro";
import Layout from "../layouts/Layout.astro";
const allPosts = Object.entries(
  import.meta.glob("./termine/*.md", { eager: true }),
)
  .filter(([path]) => !path.split("/").pop()!.startsWith("_"))
  .map(([, post]) => post);

const stringToSeconds = (str: string): number => {
  if (!str) return 0;
  const splitted = str.split(".");
  const day = splitted[0];
  const month = splitted[1];
  const year = splitted[2];
  const stringDate = `${month}-${day}-${year}`;
  return Date.parse(stringDate);
};

allPosts.sort(
  (a: any, b: any) =>
    stringToSeconds(a.frontmatter.date) - stringToSeconds(b.frontmatter.date),
);
---

<Layout>
  <h1>Termine und Veranstaltungen</h1>

  <ul class="blog-post-card-container">
    {
      allPosts.map((post: any, index) =>
        index === 0 ? (
          <li class="blog-post spotlight">
            <BlogCard blogpost={post} spotlight={true} />
          </li>
        ) : (
          <li class="blog-post">
            <BlogCard blogpost={post} />
          </li>
        ),
      )
    }
  </ul>
</Layout>

<style>
  h1 {
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .blog-post-card-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 980px);
    margin-inline: auto;
    padding: 0;
    margin-top: 0;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }

    row-gap: 1.1rem;
    column-gap: 1.1rem;

    .blog-post {
      list-style: none;

      &.spotlight {
        grid-column: 1 / -1;
      }
    }
  }
</style>
