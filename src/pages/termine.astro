---
import Termin_card from "../components/Termin_card.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const termine = await getCollection("termine");

const parseDate = (str: string): number => {
  const [day, month, year] = str.split(".");
  return Date.parse(`${year}-${month}-${day}`);
};

termine.sort(
  (a, b) => parseDate(a.data.date ?? "") - parseDate(b.data.date ?? ""),
);
---

<Layout>
  <h1>Termine und Veranstaltungen</h1>

  <ul class="blog-post-card-container">
    {
      termine.map((termin, index) =>
        index === 0 ? (
          <li class="blog-post spotlight">
            <Termin_card termin={termin} spotlight={true} />
          </li>
        ) : (
          <li class="blog-post">
            <Termin_card termin={termin} />
          </li>
        ),
      )
    }
  </ul>
</Layout>

<style>
  h1 {
    margin-bottom: 1.2rem;
    text-align: center;
  }

  .blog-post-card-container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(100%, 980px);
    margin-inline: auto;
    padding: 0;
    margin-top: 0;

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
    }

    row-gap: 1.1rem;
    column-gap: 1.1rem;

    .blog-post {
      list-style: none;

      &.spotlight {
        grid-column: 1 / -1;
      }
    }
  }
</style>
