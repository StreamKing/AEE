    font-size: 1.2rem;
    color: var(--text-secondary, #666);
    margin-bottom: 2rem;
    text-align: center;
  }

  section {
    margin-bottom: 2.5rem;
  }

  h1 {
    word-wrap: break-word;
  }

  h2 {
    color: var(--primary-color, #2c5282);
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  h3 {
    color: var(--primary-color, #2c5282);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.2rem;
  }

  ul {
    list-style-type: none;
    padding-left: 2rem;
    margin: 1rem 0;
  }

  ul ul {
    list-style-type: none;
    margin-top: 0.5rem;
  }

  li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .note {
    font-style: italic;
    color: var(--text-secondary, #666);
    margin-top: 1rem;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
  }

  th,
  td {
    border: 1px solid var(--border-color, #2c5282);
    padding: 0.75rem;
    text-align: left;
  }

  th {
    background-color: var(--table-header-bg, #2c5282);
    color: #ffffff;
    font-weight: bold;
  }

  a {
    color: var(--link-color, #2563eb);
    text-decoration: none;
  }

  a:hover {
