---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1>Förderungen der Gemeinde Sulzbach</h1>
  <h2>Haftungsausschluss</h2>
  <p>
    Die hier aufgeführten Informationen haben keinen Anspruch auf Richtigkeit
    und Vollständigkeit. Diese Informationen dienen nur zur Information über die
    Förderungen der Gemeinde Sulzbach am Taunus. Die Tatsächlichen Informationen
    finden sie auf der <a
      aria-label="Link zu den Förderprogrammen der Gemeinde Sulzbach am Taunus"
      href="https://www.sulzbach-taunus.de/kundenservice-rathaus/verwaltung/fachbereiche/planung-bauen-liegenschaften/foerderprogramme-der-gemeinde"
      >Seite der Gemeinde</a
    >.
  </p>

  <p class="filter-container">
    Nach Stichwort suchen:
    <input id="keyword_filter" type="text" />
  </p>
  <div class="fundings-container">
    <div class="fundings"></div>
  </div>

  <style>
    .filter-container {
      border: 0.063rem solid var(--border-color, grey);
      display: inline-flex;
      padding: 0.5rem 1rem;
      gap: 0.5rem;
      align-items: center;
      input {
        padding: 0.5rem;
        border: 0.063rem solid var(--border-color);
      }
    }
    .fundings-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      .fundings {
        container-type: inline-size;
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr 1fr 1fr;
        .funding-card {
          display: grid;
          grid-template-columns: subgrid;
          border: 1px solid var(--border-color);
          padding: 1rem;
          overflow-wrap: break-word;
          .funding-name {
            font-weight: bold;
          }

          h4 {
            margin-bottom: 0;
          }

          h4 + p {
            margin-top: 0;
          }

          h4:has(+ p:empty) {
            display: none;
          }

          p:empty {
            display: none;
          }

          .link-button {
            width: max-content;
            height: max-content;
            padding: 8px 16px;
            font-weight: bold;
            border: 1px solid var(--border-color);
            overflow-wrap: anywhere;

            &:hover {
              background-color: var(--primary-color);
              color: black;
            }
          }
        }
      }

      @container (max-width: 1090px) {
        .fundings {
          grid-template-columns: 1fr 1fr;
        }
      }

      @container (max-width: 720px) {
        .fundings {
          grid-template-columns: 1fr;
        }
      }
    }
  </style>

  <script>
    import { FUNDINGS, type FundingEntry } from "../data/fundings.ts";

    for (const fundingName in FUNDINGS["cities"]["sulzbach"]) {
      const funding = (
        FUNDINGS["cities"]["sulzbach"] as { [key: string]: FundingEntry }
      )[fundingName];

      const fundingCalculator = funding?.calc ? `` : "";

      const fundingDiv = document.createElement("div");

      fundingDiv.classList.add("funding-card");
      fundingDiv.innerHTML = `
      <h3 class="funding-name">${fundingName}</h3>
      <h4 class="funding-description-title">Beschreibung</h4>
      <p class="funding-description">${funding.description}</p>
      <h4>Richtlinien</h4>
      <p class="funding-policy">${funding.policy}</p>
      <h4>Höhe der Förderung</h4>
      <p class="funding-funding">${funding.funding}</p>
      ${fundingCalculator}
      <a class="link-button" href="${funding.link}">Download PDF</a>
    `;

      document.querySelector(".fundings")?.appendChild(fundingDiv);

      const filterIInput = document.getElementById("keyword_filter");
      filterIInput?.addEventListener("input", (event) => {
        const target = event.target as HTMLInputElement;
        const keyword = target.value.toLowerCase();

        if (
          fundingName.toLowerCase().includes(keyword) ||
          funding.description.toLowerCase().includes(keyword) ||
          funding.policy.toLowerCase().includes(keyword) ||
          funding.funding.toLowerCase().includes(keyword)
        ) {
          const result = new RegExp(keyword, "gi");
          const fundingDescriptions = fundingDiv.querySelectorAll(
            ".funding-name, .funding-description, .funding-policy, .funding-funding",
          );
          fundingDescriptions.forEach((element) => {
            element.innerHTML = element.textContent?.replace(
              result,
              (match) => `<mark>${match}</mark>`,
            ) as string;
          });
          fundingDiv.style.display = "block";
        } else {
          fundingDiv.style.display = "none";
        }
      });
    }
  </script>
</Layout>
