---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1>Förderungen der Gemeinde Sulzbach</h1>
  <h2>Haftungsausschluss</h2>
  <p>
    Die hier aufgeführten Informationen haben keinen Anspruch auf Richtigkeit
    und Vollständigkeit. Diese Informationen dienen nur zur Information über die
    Förderungen der Gemeinde Sulzbach am Taunus. Die tatsächlichen Informationen
    finden Sie auf der <a
      aria-label="Link zu den Förderprogrammen der Gemeinde Sulzbach am Taunus"
      href="https://www.sulzbach-taunus.de/kundenservice-rathaus/verwaltung/fachbereiche/planung-bauen-liegenschaften/foerderprogramme-der-gemeinde"
      >Seite der Gemeinde</a
    >.
  </p>

  <p class="filter-container">
    Nach Stichwort suchen:
    <input id="keyword_filter" type="text" />
  </p>
  <div class="fundings-container">
    <div class="fundings"></div>
  </div>

  <style>
    .filter-container {
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background-color: var(--surface-color);
      display: inline-flex;
      padding: 0.5rem 1rem;
      gap: 0.5rem;
      align-items: center;

      input {
        min-height: 38px;
        border-radius: var(--radius-md);
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color);
      }
    }

    .fundings-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;

      .fundings {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));

        .funding-card {
          display: flex;
          flex-direction: column;
          border: 1px solid var(--border-color);
          border-radius: var(--radius-lg);
          background-color: var(--surface-color);
          box-shadow: var(--shadow-sm);
          padding: 1rem;
          min-width: 0;
          overflow-wrap: break-word;

          .funding-name {
            font-weight: bold;
            margin-bottom: 0.1rem;
          }

          .funding-stand {
            font-size: 0.8rem;
            color: var(--text-muted, #666);
            margin-top: 0;
            margin-bottom: 0.75rem;
          }

          h4 {
            margin-bottom: 0;
          }

          h4 + p {
            margin-top: 0;
          }

          p:empty {
            display: none;
          }

          .details-button {
            background: none;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 0.4rem 0.75rem;
            cursor: pointer;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            align-self: flex-start;
          }

          .details-button:hover {
            background-color: var(--border-color);
          }

          .link-button {
            margin-top: auto;
            padding-top: 0.5rem;
            align-self: flex-start;
          }
        }
      }
    }

    @media (max-width: 520px) {
      .filter-container {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
      }
    }

    :global(.funding-popover) {
      box-sizing: border-box;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      background-color: var(--surface-color);
      box-shadow: var(--shadow-sm);
      padding: 1.5rem;
      margin: auto;
      width: min(calc(100vw - 2rem), 640px);
      max-width: 640px;
      min-width: 0;
      max-height: min(85dvh, 760px);
      overflow: auto;
      overflow-wrap: anywhere;
      word-break: break-word;
      hyphens: auto;
    }

    :global(.funding-popover:popover-open) {
      inset: 0;
      margin: auto;
      width: min(calc(100vw - 2rem), 640px);
      max-width: 640px;
    }

    :global(.funding-popover)::backdrop {
      background: rgba(0, 0, 0, 0.4);
    }

    :global(.funding-popover h3) {
      margin-top: 0;
    }

    :global(.funding-popover h4) {
      margin-bottom: 0.25rem;
    }

    :global(.funding-popover h4 + p) {
      margin-top: 0;
    }

    :global(.funding-popover .popover-close) {
      float: right;
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.25rem 0.5rem;
      margin: -0.25rem -0.5rem 0 0;
    }
  </style>

  <script>
    import { FUNDINGS, type FundingEntry } from "../data/fundings.ts";

    for (const fundingName in FUNDINGS["cities"]["sulzbach"]) {
      const funding = (
        FUNDINGS["cities"]["sulzbach"] as { [key: string]: FundingEntry }
      )[fundingName];

      const fundingDiv = document.createElement("div");

      const popoverId = `popover-${Math.random().toString(36).slice(2)}`;

      const popoverEl = document.createElement("div");
      popoverEl.id = popoverId;
      popoverEl.classList.add("funding-popover");
      popoverEl.setAttribute("popover", "");
      popoverEl.innerHTML = `
        <button class="popover-close" popovertarget="${popoverId}" popovertargetaction="hide" aria-label="Schließen">✕</button>
        <h3>${fundingName}</h3>
        <p class="funding-stand">${funding.stand}</p>
        <h4>Beschreibung</h4>
        <p class="funding-description">${funding.description}</p>
        <h4>Höhe der Förderung</h4>
        <p class="funding-funding">${funding.funding}</p>
      `;
      document.body.appendChild(popoverEl);

      fundingDiv.classList.add("funding-card");
      fundingDiv.innerHTML = `
      <h3 class="funding-name">${fundingName}</h3>
      <p class="funding-stand">${funding.stand}</p>
      <button class="details-button" popovertarget="${popoverId}">Details anzeigen</button>
      <a class="link-button" href="${funding.link}" target="_blank" rel="noopener noreferrer">Richtlinie herunterladen (PDF)</a>
    `;

      document.querySelector(".fundings")?.appendChild(fundingDiv);

      const filterIInput = document.getElementById("keyword_filter");
      filterIInput?.addEventListener("input", (event) => {
        const target = event.target as HTMLInputElement;
        const keyword = target.value.toLowerCase();

        if (
          fundingName.toLowerCase().includes(keyword) ||
          funding.description.toLowerCase().includes(keyword) ||
          funding.stand.toLowerCase().includes(keyword) ||
          funding.funding.toLowerCase().includes(keyword)
        ) {
          const result = new RegExp(keyword, "gi");
          const fundingDescriptions = fundingDiv.querySelectorAll(
            ".funding-name, .funding-stand",
          );
          fundingDescriptions.forEach((element) => {
            element.innerHTML = element.textContent?.replace(
              result,
              (match) => `<mark>${match}</mark>`,
            ) as string;
          });
          fundingDiv.style.display = "block";
        } else {
          fundingDiv.style.display = "none";
        }
      });
    }
  </script>
</Layout>
