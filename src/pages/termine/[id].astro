---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import MapsLink from "../../components/utility/MapsLink.astro";
import LinkButton from "../../components/LinkButton.astro";

export async function getStaticPaths() {
    const termine = await getCollection("termine");
    return termine.map((termin) => ({
        params: { id: termin.id },
        props: { termin },
    }));
}

const { termin } = Astro.props;
const { Content } = await render(termin);

const parseDate = (str: string): Date => {
    const [day, month, year] = str.split(".");
    return new Date(`${year}-${month}-${day}`);
};

const isAfterDate = (): boolean => {
    if (!termin.data.date) return false;
    return Date.now() > parseDate(termin.data.date).getTime();
};
---

<Layout>
    <div class="centered">
        <LinkButton href="/termine/" arrow="left">zurück</LinkButton>
        <div class="header">
            <h1>{termin.data.title}</h1>

            <div class="header-meta">
                <h2>
                    {
                        termin.data.date
                            ? termin.data.date
                            : "Termin noch nicht festgelegt"
                    }
                </h2>
                {
                    termin.data.time && (
                        <p class="time">
                            {termin.data.time.von}–{termin.data.time.bis} Uhr
                        </p>
                    )
                }
            </div>
        </div>
        <div class="documents">
            <p>Dokumente:</p>
            {
                termin.data.docs && termin.data.docs.length > 0 ? (
                    <>
                        <ol>
                            {termin.data.docs.map((doc) => (
                                <li>
                                    <a href={`/${doc}`} download>
                                        {doc.split("/").at(-1)}
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </>
                ) : (
                    <p>Keine Dokumente verfügbar.</p>
                )
            }
        </div>
        {
            termin.data.location && (
                <p class="location">
                    {termin.data.location}
                    {termin.data.address_for_maps && (
                        <MapsLink address={termin.data.address_for_maps} size={20} />
                    )}
                </p>
            )
        }
        {!isAfterDate() && <h4>{termin.data.description}</h4>}
        <hr />
        <div>
            <Content />
        </div>
    </div>
</Layout>

<style>
    .header {
        display: flex;
        flex-wrap: wrap;

        justify-content: space-between;
        align-items: baseline;
    }

    .documents {
        > ol {
            padding-left: 1rem;
        }
    }

    .centered {
        margin-inline: 12.5%;
    }

    .centered :global(img) {
        max-width: 100%;
        width: stretch;
        height: auto;
        object-fit: cover;
        border-radius: var(--radius-md);
    }
</style>
