---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const termine = await getCollection("termine");
    return termine.map((termin) => ({
        params: { id: termin.id },
        props: { termin },
    }));
}

const { termin } = Astro.props;
const { Content } = await render(termin);

const parseDate = (str: string): Date => {
    const [day, month, year] = str.split(".");
    return new Date(`${year}-${month}-${day}`);
};

const isAfterDate = (): boolean => {
    if (!termin.data.date) return false;
    return Date.now() > parseDate(termin.data.date).getTime();
};
---

<Layout>
    <div class="centered">
        <a class="link-button" href="/termine/">← zurück</a>
        <div class="header">
            <h1>{termin.data.title}</h1>
            <div class="header-meta">
                <h2>
                    {
                        termin.data.date
                            ? termin.data.date
                            : "Termin noch nicht festgelegt"
                    }
                </h2>
                {
                    termin.data.time && (
                        <p class="time">
                            {termin.data.time.von}–{termin.data.time.bis} Uhr
                        </p>
                    )
                }
            </div>
        </div>
        {
            termin.data.location && (
                <p class="location">
                    {termin.data.location}
                    {termin.data.mapsUrl && (
                        <a
                            href={termin.data.mapsUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Auf Google Maps anzeigen"
                            class="maps-link"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                                <circle cx="12" cy="9" r="2.5" />
                            </svg>
                        </a>
                    )}
                </p>
            )
        }
        {!isAfterDate() && <h4>{termin.data.description}</h4>}
        <hr />
        <div>
            <Content />
        </div>
        {isAfterDate() && <hr />}
        {
            isAfterDate() && (
                <details style="cursor:pointer">
                    <summary style="cursor:pointer">
                        Vergangene Nachrichten
                    </summary>
                    <h4>{termin.data.description}</h4>
                </details>
            )
        }
    </div>
</Layout>

<style>
    .header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .location {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .maps-link {
        display: inline-flex;
        color: var(--primary-color);
    }

    .maps-link:hover {
        color: var(--primary-hover-color);
    }

    .centered {
        margin-inline: 12.5%;
    }

    .centered :global(img) {
        max-width: 100%;
        width: stretch;
        height: auto;
        object-fit: cover;
        border-radius: var(--radius-md);
    }
</style>
