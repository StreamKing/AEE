---
import { BASE_URL } from "../../config";
import TerminList from "./TerminList.astro";
import EventSpotlight from "./EventSpotlight.astro";
import { getCollection } from "astro:content";
import solarberatungImage1 from "../assets/Events/Solarberatung_05_05/1.jpg";
import solarberatungImage2 from "../assets/Events/Solarberatung_05_05/2.jpg";

const termine = await getCollection("termine");
---

<section class="hero">
  <p class="badge">Energie vor Ort</p>
  <h1>Willkommen bei AEE Sulzbach</h1>
  <h2>
    Bei uns dreht sich alles um erneuerbare Energien und die Umwelt in der
    Sulzbacher Gemeinde.
  </h2>
</section>

<section class="mission-statement">
  <h2>Unsere Mission</h2>
  <p>
    Wir setzen uns für eine nachhaltige Energiezukunft ein, indem wir
    Informationen, Beratung und Unterstützung rund um erneuerbare Energien in
    Sulzbach bieten. Unser Ziel ist es, die Gemeinschaft zu stärken und den
    Übergang zu einer grüneren Zukunft zu fördern.
  </p>
</section>

<section>
  <h2>Kontakt</h2>
  habt ihr Fragen oder möchtet mehr über unsere Arbeit erfahren? Kontaktiert uns gerne
  oder kommt einfach vorbei!
  <p>
    E-Mail: <a href="mailto:info@aee-sulzbach.de"> info@aee-sulzbach.de </a>
  </p>
</section>

<section>
  <EventSpotlight
    eventId="Bürgersolar_beratung"
    recap="Viele gute Fragen und ein reger Austausch prägten unseren Bürgersolarberatungstermin am 5. Mai. Es war großartig, so viele interessierte Bürgerinnen und Bürger zu begrüßen, die sich über die Möglichkeiten der Solarenergie informieren wollten. Unser Team stand bereit, um individuelle Fragen zu beantworten."
    thanks="an alle die da waren und besonders dem Verein Klimabewusstes Bad Soden e.V."
    images={[
      {
        src: solarberatungImage1.src,
        alt: "Besucherinnen und Besucher bei der Bürgersolarberatung von hinten fotografiert",
        caption: "Danke an die zwei Redner für die informative Beratung",
      },
      {
        src: solarberatungImage2.src,
        alt: "Banner des Vereins Klimabewusstes Bad Soden e.V. bei der Bürgersolarberatung",
        caption: "Klimabewusstes Bad Soden e.V.",
      },
    ]}
  />
</section>

<section class="termin-list">
  <TerminList termine={termine} />
</section>

<style>
  .hero {
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(20px, 5vw, 48px);
    text-align: center;
  }

  .badge {
    margin: 0;
    font-weight: 700;
    color: var(--primary-color-strong);
  }

  h1 {
    margin: 0.3rem 0 0;
  }

  h2 {
    margin: 0.8rem auto 0;
    max-width: 55ch;
    font-weight: 500;
  }

  .mission-statement {
    margin: 2rem 0;
    padding: 1.5rem;

    h2 {
      margin-top: 0;
    }
  }

  .termin-list {
    margin: 3rem 0;
  }
</style>
