---
const { layout } = Astro.props;
---

<main class={layout}>
    <slot />
</main>

<style>
    main {
        flex: 1 0 auto;
        width: min(var(--content-max-width), 100%);
        margin-inline: auto;
    }

    main.centered {
        max-width: var(--content-max-width-readable);
        text-align: center;
    }
</style>
