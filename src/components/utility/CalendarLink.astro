---
interface Props {
    href: string;
    filename: string;
}

const { href, filename } = Astro.props;
---

<a class="calendar-link" href={href} download={filename}>
    In Kalender speichern
</a>

<style>
    .calendar-link {
        width: max-content;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        padding: 8px 16px;
        border: 1px solid var(--primary-color);
        border-radius: var(--radius-md);
        background-color: var(--primary-color);
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.2s ease;
    }

    .calendar-link:hover,
    .calendar-link:focus-visible {
        background-color: var(--primary-color-strong);
        border-color: var(--primary-color-strong);
        color: #ffffff;
    }

    .calendar-link:hover {
        transform: translateY(-1px);
    }
</style>
