---
import { BASE_URL } from "../../config";
import { Image } from "astro:assets";
import AeeLogo from "../assets/aee_logo.svg";
---

<header>
  <a href="/" aria-label="Startseite"
    ><Image class="aee-logo" src={AeeLogo} alt="" />
  </a>
  <div class="nav-container">
    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        <li><a href={BASE_URL}>Start</a></li>
        <li><a href={BASE_URL + "about"}>Über uns</a></li>
        <li><a href={BASE_URL + "fundings"}>Förderungen</a></li>
        <li>
          <a href={BASE_URL + "solar-consultation"}>Bürgersolar Beratung</a>
        </li>
        <li><a href={BASE_URL + "blog"}>Blog</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    display: grid;
    gap: 8px;
    grid-template-columns: var(--header-grid-columns);

    .nav-container {
      justify-items: var(--header-justify-nav-container);
    }

    .aee-logo {
      height: 72px;
      width: fit-content;
    }
  }

  .nav-container {
    container-type: inline-size;
    --navigation-items-layout: row;
    @container (max-width: 495px) {
      .nav {
        width: 100%;
        ul {
          --navigation-items-layout: column;
          width: 100%;
        }
      }
    }
    .nav {
      ul {
        display: flex;
        gap: 1rem;
        list-style: none;

        padding: 0;
        flex-direction: var(--navigation-items-layout);
        justify-content: var(--header-justify-nav-container);

        li {
          cursor: pointer;
          white-space: nowrap;
          height: 32px;
          display: flex;
          align-items: center;

          border-bottom: 1px solid var(--nav-item-background-hover-color);

          &:hover {
            background-color: var(--nav-item-background-hover-color, red);
            a {
              color: var(--nav-item-text-color-hover-color, white);
            }
          }

          a {
            text-decoration: none;
            padding: 0.5rem;
            width: 100%;
          }

          &.current-page {
            border-width: 3px;
          }
        }
      }
    }
  }
</style>

<script>
  const allLinks = document.querySelectorAll(
    'li:has( > a[href="' + window.location.pathname + '"])',
  );
  allLinks.forEach((link) => {
    link.classList.add("current-page");
  });
</script>
