---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { BASE_URL } from "../../config";
import MapsLink from "./MapsLink.astro";
import LinkButton from "./LinkButton.astro";
import CalendarLink from "./CalendarLink.astro";

interface Props {
  termin: CollectionEntry<"termine">;
  spotlight?: boolean;
  skipDetails?: boolean;
}

const { termin, spotlight, skipDetails } = Astro.props;
const { Content } = await render(termin);

const escapeIcalText = (value: string) =>
  value
    .replace(/\\/g, "\\\\")
    .replace(/;/g, "\\;")
    .replace(/,/g, "\\,")
    .replace(/\r?\n/g, "\\n");

const formatIcalDate = (date: string) => {
  const [day, month, year] = date.split(".");
  return `${year}${month}${day}`;
};

const formatIcalDateTime = (date: string, time: string) =>
  `${formatIcalDate(date)}T${time.replace(":", "")}00`;

const calendarUrl = termin.data.date
  ? `data:text/calendar;charset=utf-8,${encodeURIComponent(
      [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//AEE Sulzbach//Termine//DE",
        "BEGIN:VEVENT",
        `UID:${termin.id}@aee-sulzbach.de`,
        `DTSTAMP:${new Date()
          .toISOString()
          .replace(/[-:]/g, "")
          .replace(/\.\d{3}/, "")}`,
        termin.data.time
          ? `DTSTART:${formatIcalDateTime(termin.data.date, termin.data.time.von)}`
          : `DTSTART;VALUE=DATE:${formatIcalDate(termin.data.date)}`,
        ...(termin.data.time
          ? [
              `DTEND:${formatIcalDateTime(termin.data.date, termin.data.time.bis)}`,
            ]
          : []),
        `SUMMARY:${escapeIcalText(termin.data.title)}`,
        ...(termin.data.description
          ? [`DESCRIPTION:${escapeIcalText(termin.data.description)}`]
          : []),
        ...(termin.data.location
          ? [`LOCATION:${escapeIcalText(termin.data.location)}`]
          : []),
        "END:VEVENT",
        "END:VCALENDAR",
      ].join("\r\n"),
    )}`
  : undefined;
---

<div class="card">
  <div class="header">
    <h2>{termin.data.title}</h2>
    <h4>{termin.data.date}</h4>
  </div>
  <div class="spotlight-content">
    {
      spotlight && termin.data.location && (
        <p class="location">
          <strong>Wo:</strong> {termin.data.location}
          {termin.data.mapsUrl && <MapsLink url={termin.data.mapsUrl!} />}
        </p>
      )
    }
    {
      spotlight && termin.data.date && (
        <p class="location">
          <strong>Wann:</strong> {termin.data.date}
        </p>
      )
    }
    {
      spotlight && termin.data.time && (
        <p class="location">
          <strong>Uhrzeit:</strong> {termin.data.time.von} -{" "}
          {termin.data.time.bis}
        </p>
      )
    }
    {spotlight && <Content />}
  </div>
  {
    !spotlight && !skipDetails && termin.data.description && (
      <p>{termin.data.description}</p>
    )
  }
  {
    !skipDetails && (
      <LinkButton href={`${BASE_URL}termine/${termin.id}`} arrow="right">
        Details
      </LinkButton>
    )
  }
  {
    calendarUrl && (
      <CalendarLink href={calendarUrl} filename={`${termin.id}.ics`} />
    )
  }
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--surface-color);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px;
    gap: 0.6rem;

    &:hover {
      border-color: var(--primary-color);
    }

    > .header {
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;

      h2 {
        margin: 0;
      }

      h4 {
        margin: 0;
        white-space: nowrap;
      }
    }

    > .spotlight-content {
      display: none;
      margin: 0.3rem 0 0.5rem;
      max-width: 70ch;
      line-height: 1.6;

      .location {
        margin: 0 0 0.4rem;
      }
    }
    img {
      width: 100%;
    }
  }

  .card:has(.spotlight-content > *) .spotlight-content {
    display: block;
  }
</style>
