---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { BASE_URL } from "../../config";
import MapsLink from "./MapsLink.astro";
import LinkButton from "./LinkButton.astro";

interface Props {
  termin: CollectionEntry<"termine">;
  spotlight?: boolean;
}

const { termin, spotlight } = Astro.props;
const { Content } = await render(termin);
---

<div class="card">
  <div class="header">
    <h2>{termin.data.title}</h2>
    <h4>{termin.data.date}</h4>
  </div>
  <div class="spotlight-content">
    {
      spotlight && termin.data.location && (
        <p class="location">
          <strong>Wo:</strong> {termin.data.location}
          {termin.data.mapsUrl && <MapsLink url={termin.data.mapsUrl} />}
        </p>
      )
    }
    {spotlight && <Content />}
  </div>
  {!spotlight && termin.data.description && <p>{termin.data.description}</p>}
  <LinkButton href={`${BASE_URL}termine/${termin.id}`} arrow="right"
    >Details</LinkButton
  >
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--surface-color);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px;
    gap: 0.6rem;

    &:hover {
      border-color: var(--primary-color);
    }

    > .header {
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;

      h2 {
        margin: 0;
      }

      h4 {
        margin: 0;
        white-space: nowrap;
      }
    }

    > .spotlight-content {
      display: none;
      margin: 0.3rem 0 0.5rem;
      max-width: 70ch;
      line-height: 1.6;

      .location {
        margin: 0 0 0.4rem;
      }
    }
  }

  .card:has(.spotlight-content > *) .spotlight-content {
    display: block;
  }
</style>
