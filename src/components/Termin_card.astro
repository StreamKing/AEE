---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { BASE_URL } from "../../config";

interface Props {
  termin: CollectionEntry<"termine">;
  spotlight?: boolean;
}

const { termin, spotlight } = Astro.props;
const { Content } = await render(termin);
---

<div class="card">
  <div class="header">
    <h2>{termin.data.title}</h2>
    <h4>{termin.data.date}</h4>
  </div>
  <div class="spotlight-content">
    {
      spotlight && termin.data.location && (
        <p class="location">
          <strong>Wo:</strong> {termin.data.location}
          {termin.data.mapsUrl && (
            <a
              href={termin.data.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Auf Google Maps anzeigen"
              class="maps-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                <circle cx="12" cy="9" r="2.5" />
              </svg>
            </a>
          )}
        </p>
      )
    }
    {spotlight && <Content />}
  </div>
  {!spotlight && termin.data.description && <p>{termin.data.description}</p>}
  <a class="link-button" href={`${BASE_URL}termine/${termin.id}`}>Details →</a>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--surface-color);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px;
    gap: 0.6rem;

    &:hover {
      border-color: var(--primary-color);
    }

    > .header {
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;

      h2 {
        margin: 0;
      }

      h4 {
        margin: 0;
        white-space: nowrap;
      }
    }

    > .spotlight-content {
      display: none;
      margin: 0.3rem 0 0.5rem;
      max-width: 70ch;
      line-height: 1.6;

      .location {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0 0 0.4rem;
      }

      .maps-link {
        display: inline-flex;
        color: var(--primary-color);
      }

      .maps-link:hover {
        color: var(--primary-hover-color);
      }
    }
  }

  .card:has(.spotlight-content > *) .spotlight-content {
    display: block;
  }
</style>
