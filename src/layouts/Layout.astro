---
import "../colors.css";
import "../global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Main from "../components/Main.astro";

const { centered } = Astro.props;

const layout = centered ? "centered" : "full-width";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <meta name="generator" content={Astro.generator} />

    <title>AEE Sulzbach</title>
  </head>
  <body>
    <Header />
    <Main layout={layout}>
      <slot />
    </Main>
    <Footer />
  </body>
</html>

<style>
  .nav-container {
    display: flex;
    justify-content: end;
  }
</style>

<style>
  html,
  body {
    container-type: inline-size;
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;

    background-color: var(--background-color);

    --header-grid-columns: min-content auto;
    --header-justify-nav-container: end;
    @container (max-width: 521px) {
      header {
        --header-grid-columns: auto;
        --header-justify-nav-container: start;
      }
    }
  }
</style>
